
@{
    ViewBag.Title = "product";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product List</title>
    <link rel="stylesheet" 
          href="~/Content/product.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="produck.css" />
</head>
<body>
    <header>
        <div class="logo">
            Amazon
        </div>
        <div class="search-box">
            <input type="text" placeholder="Search Amazon" />
            <button>
                <i class="fas fa-search"></i>
            </button>
        </div>
        <div class="account">
            Hello,Sign in<br />
            <b>Account & Lists</b>
        </div>
        <div class="orders">
            Returns<br />
            <b>& Orders</b>
        </div>
        <div class="cart">
            <i class="fas fa-shopping-cart"></i>
            Cart
        </div>
    </header>

    <nav>
        <div>
            <i class="fas fa-search-bars"></i>
            All
        </div>
        <div>Today's Deals'</div>
        <div>Prime Video</div>
        <div>Buy Again</div>
        <div>Customer</div>
        <div>Registry</div>
        <div>Gift Cards</div>
        <div>Sell</div>
    </nav>

    <main>

        <aside>
            <h3>Department</h3>

            <p>Home & Kitchen</p>
            <p>Home Cleaning</p>
            <p>Kitchen Tools</p>

            <h3>Customer Reviews</h3>

            <p>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>

                & Up
            </p>
            <h3>Deals & Discounts</h3>
            <p>All Discounts</p>
            <p>Today's Deals</p>

            <h3>Price</h3>

            <p>Under $10</p>
            <p>$10 to $20</p>
            <p>$20 to $35</p>
            <p>$35 & Above</p>

        </aside>

        <section class="product-area">
            <h2>Results</h2>
            <p>check each product page for other buying options.</p>

            <div class="product-liss">
                <div class="product">
                    <img src="~/Images/product1.jpg"
                         alt="product1" />
                    <h3>
                        Electric Spin Scrubber
                    </h3>

                    <h4>
                        <span class="icon rating-outer">
                            <span class="icon rating-inner" style="width: 87.5%"></span>
                        </span>
                        (1.6K reviews)
                    </h4>
                    <p class=" price">
                        $39.99
                    </p>

                    <button>
                        Add to cart
                    </button>
                </div>

                <div class="product">
                    <img src="~/Images/product2.jpg"
                         alt="product 2" />
                    <h3>
                        Casabella Power Spin Scrubber
                    </h3>
                    <h4>
                        <span class="icon rating-outer">
                            <span class="icon rating-inner" style="width: 80%"></span>
                        </span>
                        (42 reviews)
                    </h4>
                    <p class=" price">
                        $49.99
                    </p>

                    <button>
                        Add to cart
                    </button>
                </div>

                <div class="product">
                    <img src="~/Images/product3.jpg"
                         alt="product 3" />
                    <h3>
                        Elictric Spin Scrubber
                    </h3>
                    <h4>
                        <span class="icon rating-outer">
                            <span class="icon rating-inner" style="width: 90%"></span>
                        </span>
                        (128 reviews)
                    </h4>
                    <p class=" price">
                        $35.99
                    </p>

                    <button>
                        Add to cart
                    </button>
                </div>

                <div class="product">
                    <img src="~/Images/product4.jpg"
                         alt="Product 4" />

                    <h3>
                        Handheld spin Scrubbler
                    </h3>

                    <h4>
                        <span class="icon rating-outer">
                            <span class="icon rating-inner" style="width: 75%"></span>
                        </span>
                        (35 reviews)
                    </h4>
                    <p class=" price">
                        $37.49
                    </p>

                    <button>
                        Add to cart
                    </button>
                </div>
            </div>
        </section>
    </main>

    <footer>

        <div>
            <h3>Ger to Know Us</h3>
            <p>Careers</p>
            <p>About Amazon</p>
            <p>Inverstor Relations</p>
        </div>

        <div>
            <h3>Make Money with Us</h3>
            <p>Sell products</p>
            <p>Sell on Amazon</p>
            <p>Become an Affiliate</p>
        </div>

        <div>
            <h3>Amazon Payment Produccts</h3>
            <p>Amazon Visa</p>
            <p>Credit Card</p>
        </div>
        <div>
            <h3>Let Us Help You</h3>
            <p>Your Account</p>
            <p>Your Orders</p>
            <p>Help</p>
        </div>
    </footer>

</body>

